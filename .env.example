AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Bedrock Model ID - Claude 4.x models (ACTIVE status):
# BEDROCK_MODEL_ID=anthropic.claude-opus-4-7              # Most capable
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6            # Balanced (recommended)
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0  # Fast
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0   # Fastest, lowest cost
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Storage
DESIGNS_PATH=/app/designs

# Static Mode (Vite + React)
VITE_PORT_START=5173
VITE_PORT_END=5222
MAX_VITE_SERVERS=3
VITE_IDLE_TIMEOUT=300000

# Dynamic Mode (Docker-out-of-Docker + Next.js + Postgres)
DOCKER_ENABLED=true
DOCKER_PORT_START=6001
DOCKER_PORT_END=6100
MAX_DOCKER_STACKS=3
DOCKER_STARTUP_TIMEOUT=60000
DOCKER_IDLE_TIMEOUT=600000
POSTGRES_IMAGE=postgres:16-alpine
NEXTJS_APP_IMAGE=node:20-alpine
DYNAMIC_POSTGRES_PASSWORD=devpassword
